    "FEATURE_SCALE_DIAGNOSTIC_COMPLETED_NO_P0_REVIEW_REQUIRED",
    "BLOCKED_MANIFEST_LEAKAGE_P0",
    "BLOCKED_BOUNDARY_FLAG",
    "BLOCKED_DIAGNOSTIC_RUNTIME_ERROR"
  ],
  "transform_policy": {
    "policy_scope": "diagnostic_only",
    "train_only_fit_required": true,
    "save_scaler": false,
    "model_training_allowed": false,
    "stable_allowed": false,
    "recommended_transform_groups": {
      "log1p_recommended": "raw volume / amount features and extreme spike ratios",
      "standardize_recommended": "continuous numeric features; train fit only, valid transform only",
      "clip_winsorize_review": "extreme outlier features; train quantiles only; no clipping performed in this task",
      "no_transform_or_bounded": "ratio / rank / return features, still eligible for standardization"
    }
  },
  "output_contract": {
