    ]
  },
  "per_feature_statistics": [
    "train_min",
    "train_max",
    "train_mean",
    "train_std",
    "valid_min",
    "valid_max",
    "valid_mean",
    "valid_std",
    "missing_count",
    "inf_count",
    "zero_variance",
    "absolute_max",
    "scale_order",
    "train_vs_valid_standardized_mean_difference"
  ],
  "global_statistics": [
    "cross_feature_std_ratio",
    "cross_feature_absolute_max_ratio",
    "features_requiring_log1p_transform",
    "features_requiring_train_only_standardization",
    "features_requiring_clipping_winsorization_review"
  ],
  "diagnostic_flags": [
