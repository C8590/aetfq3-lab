{
  "document_type": "aetfq3_intraday_dry_validation_manifest_spec",
  "lab_declaration": "本任务属于 aetfq3-lab / Lab，不属于 V2.1 Stable。",
  "boundary_statement": "本文件只用于 Lab research，不是 Stable 交易规则，不接 QMT，不生成 OrderIntent，不自动下单。",
  "manifest_version": "intraday_dry_validation_manifest_v1",
  "required_fields": [
    "manifest_version",
    "sample_type",
    "sample_path",
    "sample_path_type",
    "source_kind",
    "source_description",
    "generated_at",
    "generated_by",
    "human_authorized",
    "authorized_by",
    "authorization_scope",
    "uses_stable_bundle",
    "stable_bundle_path",
    "stable_bundle_commit",
    "stable_bundle_snapshot_date",
    "uses_qmt_export",
    "qmt_export_path",
    "qmt_mode",
    "data_time_start",
    "data_time_end",
    "row_count",
    "etf_count",
    "trade_date_count",
    "bar_count_per_etf_day",
    "contains_future_labels",
    "future_label_columns",
    "feature_columns",
    "forbidden_feature_columns",
    "has_future_leakage_check",
    "allowed_for",
    "training_allowed",
    "stable_effect_allowed",
    "advisory_only",
    "affects_stable_trading",
    "contains_secret",
    "contains_live_order",
    "contains_order_intent",
    "qmt_related",
    "review_checklist_passed",
    "notes"
  ],
  "defaults": {
    "sample_type": "intraday_5m",
    "sample_path_type_allowed": ["local_ignored", "external_readonly"],
    "training_allowed": false,
    "stable_effect_allowed": false,
    "advisory_only": true,
    "affects_stable_trading": false,
    "contains_secret": false,
    "contains_live_order": false,
    "contains_order_intent": false,
    "qmt_related": false,
    "qmt_mode_allowed": ["readonly", "mock", "export_only"],
    "allowed_for": ["dry_validation_only"]
  },
  "template": {
    "manifest_version": "intraday_dry_validation_manifest_v1",
    "sample_type": "intraday_5m",
    "sample_path": null,
    "sample_path_type": "local_ignored",
    "source_kind": null,
    "source_description": null,
    "generated_at": null,
    "generated_by": "codex_lab",
    "human_authorized": false,
    "authorized_by": null,
    "authorization_scope": null,
    "uses_stable_bundle": false,
    "stable_bundle_path": null,
    "stable_bundle_commit": null,
    "stable_bundle_snapshot_date": null,
    "uses_qmt_export": false,
    "qmt_export_path": null,
    "qmt_mode": "readonly",
    "data_time_start": null,
    "data_time_end": null,
    "row_count": null,
    "etf_count": null,
    "trade_date_count": null,
    "bar_count_per_etf_day": null,
    "contains_future_labels": false,
    "future_label_columns": [],
    "feature_columns": [],
    "forbidden_feature_columns": [],
    "has_future_leakage_check": false,
    "allowed_for": ["dry_validation_only"],
    "training_allowed": false,
    "stable_effect_allowed": false,
    "advisory_only": true,
    "affects_stable_trading": false,
    "contains_secret": false,
    "contains_live_order": false,
    "contains_order_intent": false,
    "qmt_related": false,
    "review_checklist_passed": false,
    "notes": []
  },
  "p0_rules": [
    {"check_id": "P0_HUMAN_AUTH_REQUIRED", "condition": "human_authorized == false", "fail_action": "stop before row-level read"},
    {"check_id": "P0_NO_TRAINING", "condition": "training_allowed == true", "fail_action": "stop; dry validation must remain no-training"},
    {"check_id": "P0_NO_STABLE_EFFECT", "condition": "stable_effect_allowed == true", "fail_action": "stop; Lab cannot affect Stable"},
    {"check_id": "P0_NO_STABLE_TRADING_EFFECT", "condition": "affects_stable_trading == true", "fail_action": "stop; cannot affect Stable trading"},
    {"check_id": "P0_NO_SECRET", "condition": "contains_secret == true", "fail_action": "stop; remove secret-containing data source"},
    {"check_id": "P0_NO_LIVE_ORDER", "condition": "contains_live_order == true", "fail_action": "stop; live order data forbidden"},
    {"check_id": "P0_NO_ORDER_INTENT", "condition": "contains_order_intent == true", "fail_action": "stop; OrderIntent forbidden"},
    {"check_id": "P0_QMT_MODE_BOUNDARY", "condition": "qmt_related == true and qmt_mode not in readonly/mock/export_only", "fail_action": "stop; real QMT connection forbidden"},
    {"check_id": "P0_NO_FUTURE_LABEL_FEATURE", "condition": "future_label_columns intersects feature_columns", "fail_action": "stop; remove future labels from features"},
    {"check_id": "P0_NO_FUTURE_BAR_FEATURE", "condition": "future bar used as current feature", "fail_action": "stop; rebuild features current-bar-or-past-only"},
    {"check_id": "P0_NO_TPLUS_OUTCOME_FEATURE", "condition": "T+1/T+3 outcome used as current bar feature", "fail_action": "stop; move outcome to labels only"},
    {"check_id": "P0_NO_STABLE_OUTPUT_RUNTIME", "condition": "writes Stable output/runtime", "fail_action": "stop and remove unauthorized output"},
    {"check_id": "P0_NO_REAL_QMT", "condition": "connects real QMT", "fail_action": "stop; disconnect QMT"},
    {"check_id": "P0_NO_AUTO_TRADE", "condition": "automatic order placement", "fail_action": "stop; report boundary breach"},
    {"check_id": "P0_NO_STABLE_PARAM_CHANGE", "condition": "changes final_buy_action or target_weight or BUY/PROBE thresholds", "fail_action": "stop; revert unauthorized changes"}
  ],
  "p1_rules": [
    "QMT export data source requires human review",
    "date range is too short",
    "bar_count_per_etf_day is unstable",
    "missing vwap / amount / volume",
    "missing sector / candidate context",
    "missing future leakage check",
    "source_kind is unclear"
  ],
  "p2_rules": [
    "field names need standardization",
    "optional context fields are missing",
    "follow-up data quality report is needed"
  ],
  "phase_gate": {
    "can_enter_real_intraday_dry_validation_without_manifest_instance": false,
    "requires_human_authorization": true,
    "requires_forbidden_feature_scan": true,
    "requires_future_leakage_check": true,
    "requires_qmt_stable_order_intent_boundary_check": true
  }
}

