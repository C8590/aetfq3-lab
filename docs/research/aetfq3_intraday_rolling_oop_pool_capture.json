    "model_training_allowed": false,
    "stable_allowed": false,
    "qmt_allowed": false,
    "order_intent_allowed": false,
    "model_saved": false,
    "scaler_saved": false,
    "checkpoint_saved": false,
    "gpu_used": false,
    "torchrun_used": false,
    "qmt_used": false,
    "order_intent_generated": false,
    "stable_affected": false,
    "not_trading_advice": true
  },
  "not_advisory_package": true,
