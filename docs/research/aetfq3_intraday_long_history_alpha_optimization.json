    "profit_factor",
    "average_trade_return",
    "monthly_win_rate",
    "turnover",
    "average_exposure",
    "cost_paid",
    "net_vs_equal_weight_benchmark",
    "net_vs_cash",
    "worst_month",
    "best_month",
    "etf_contribution",
    "month_concentration",
    "etf_concentration"
  ],
  "candidate_status_allowed": [
    "LAB_DIAGNOSTIC_ALPHA_CANDIDATE_REVIEW_REQUIRED"
  ],
  "decision_values": [
    "LONG_HISTORY_ALPHA_OPTIMIZATION_COMPLETED_CANDIDATES_FOUND_REVIEW_REQUIRED",
    "LONG_HISTORY_ALPHA_OPTIMIZATION_COMPLETED_NO_CANDIDATES_FOUND",
